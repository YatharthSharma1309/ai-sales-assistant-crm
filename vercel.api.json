{
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build:api && npm run db:migrate:deploy --workspace=packages/api",
  "outputDirectory": "public",
  "framework": null,
  "crons": [
    {
      "path": "/api/automation/cron/stale-deal-alerts",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/integrations/cron/calendar-sync",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/integrations/cron/gmail-sync",
      "schedule": "30 */3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}

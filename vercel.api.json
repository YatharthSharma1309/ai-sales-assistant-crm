{
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build:api && npm run db:migrate:deploy --workspace=packages/api",
  "outputDirectory": "public",
  "framework": null,
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 9 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}

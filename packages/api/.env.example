DATABASE_URL="file:./dev.db"
NODE_ENV=development
JWT_SECRET="change-me-in-production"
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_ABSOLUTE_TTL_DAYS=90
INVITE_EXPIRY_HOURS=168
TRUST_PROXY=0
REFRESH_COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
# Set to 1 for local dev to avoid 429s during heavy UI/testing; must be 0 in production
RATE_LIMIT_DISABLED=1
PORT=3001
# Production only — encrypts workspace Google OAuth secrets at rest (64 hex chars)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRETS_ENCRYPTION_KEY=""
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"
OPENROUTER_SITE_URL=""
OPENROUTER_SITE_NAME="AI Sales Assistant CRM"
# Leave empty for full mock mode (no Resend calls).
# When set in dev, Resend API errors return sent:false instead of crashing routes.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Sales <onboarding@resend.dev>"
EMAIL_LOG_DOMAIN=""
INBOUND_EMAIL_WEBHOOK_SECRET=""
# Google Calendar & Gmail (optional — managers can also set these on Integrations page)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/api/integrations/google/callback"
GMAIL_REDIRECT_URI="http://localhost:3001/api/integrations/gmail/callback"
GMAIL_SYNC_ENABLED="false"
GMAIL_SYNC_INTERVAL_MS="1800000"
HUBSPOT_CLIENT_ID=""
HUBSPOT_CLIENT_SECRET=""
HUBSPOT_REDIRECT_URI="http://localhost:3001/api/integrations/hubspot/callback"
SALESFORCE_CLIENT_ID=""
SALESFORCE_CLIENT_SECRET=""
SALESFORCE_REDIRECT_URI="http://localhost:3001/api/integrations/salesforce/callback"
SALESFORCE_LOGIN_URL="https://login.salesforce.com/services/oauth2/authorize"
SALESFORCE_TOKEN_URL="https://login.salesforce.com/services/oauth2/token"
FRONTEND_URL="http://localhost:5173"
CORS_ORIGINS=""
CALENDAR_SYNC_ENABLED="false"
CALENDAR_SYNC_INTERVAL_MS="3600000"
CALENDAR_SYNC_DAYS="14"
CRON_SECRET=""
# Daily stale-deal alert emails (local: use Settings → Run alerts now, or enable job)
STALE_DEAL_ALERTS_ENABLED="false"
STALE_DEAL_ALERTS_INTERVAL_MS="86400000"
